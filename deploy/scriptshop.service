[Unit]
Description=scriptshop
After=network.target

[Service]
User=scriptshop
Group=scriptshop
Environment=SCRIPTSHOP_DATA=/var/lib/scriptshop
ExecStart=/usr/local/bin/scriptshop serve -addr 127.0.0.1:8080 -trust-proxy
Restart=on-failure

# the server only reads its data
ReadOnlyPaths=/var/lib/scriptshop
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
MemoryMax=512M

[Install]
WantedBy=multi-user.target
